# ==============================================================================
# Docker Build Exclusion List (.dockerignore)
# Prevents secrets, tests, caches, and local environments from baking into images
# ==============================================================================

# Version Control
.git
.gitignore

# Environment Files & Secrets (NEVER bake credentials into Docker images)
.env
.env.local
.env.*
*.env

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class

# Testing Suites & Coverage Artifacts
.pytest_cache/
.coverage
htmlcov/
tests/

# Virtual Environments
.venv/
venv/
ENV/
env/

# IDE & Editor Metadata
.vscode/
.idea/
*.swp
*.swo

# Local Log Files
*.log
logs/

# OS Generated Files
.DS_Store
Thumbs.db
