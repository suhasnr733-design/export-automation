# ==============================================================================
# API 3 - EXPORT AUTOMATION SYSTEM CONFIGURATION (.env.example)
# Copy this file to .env and configure values for your environment.
# All sensitive credentials MUST remain confidential and NEVER be committed.
# ==============================================================================

# --- Safety Mode (CRITICAL) ---
# When true, strictly prevents real email transmission and unmetered AI usage.
# Outreach dispatches will be simulated safely and logged to data/sent_log.csv.
TEST_MODE=true

# --- Search & Buyer Discovery Settings ---
# Target export product or industry niche keyword
SEARCH_KEYWORD=Singing Bowls

# Discovery rate limit delay (in seconds) between web requests
SEARCH_DELAY=1.0

# Maximum number of search result pages/items to inspect per discovery run
MAX_SEARCH_RESULTS=15

# Maximum number of discovered company websites to crawl deeply for contact info
MAX_WEBSITES_PER_RESULT=5

# Set to true to use offline synthetic discovery fixtures for testing/development
TEST_DISCOVERY=false

# Optional Google Custom Search JSON API credentials (if configured)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# --- AI Classification & Qualification Settings ---
# Google Gemini API key (optional in TEST_MODE; required if CLASSIFICATION_LIVE=true)
GEMINI_API_KEY=your_gemini_api_key_here

# Target Gemini model name
GEMINI_MODEL=gemini-3.5-flash

# Set to true to route classification to live Gemini API (falls back to local heuristic if false/unavailable)
CLASSIFICATION_LIVE=false

# Maximum number of contacts evaluated per AI classification batch
CLASSIFICATION_BATCH_SIZE=20

# Confidence threshold (0.0 to 1.0) below which contacts require manual review
CLASSIFICATION_REVIEW_THRESHOLD=0.70

# --- Outreach Engine & Campaign Settings ---
# Maximum number of REAL outreach emails allowed per 24-hour window (when TEST_MODE=false)
DAILY_SEND_LIMIT=10

# Maximum number of simulated outreach emails allowed in a single test batch
TEST_SIMULATION_LIMIT=50

# Delay (in seconds) between successive email dispatches to prevent rate-limit trips
SEND_DELAY=5.0

# Relative or absolute path to the company PDF presentation attachment
PRESENTATION_PATH=assets/company_presentation.pdf

# Optional CC monitoring email address for compliance audit copies
CC_MONITOR_EMAIL=

# --- Gmail SMTP Authentication (Required only for live sending when TEST_MODE=false) ---
# Your full Gmail address used as the sender
GMAIL_EMAIL=your_email@gmail.com

# 16-character Google App Password generated in Google Account > Security > 2-Step Verification
GMAIL_APP_PASSWORD=your_16_char_app_password
